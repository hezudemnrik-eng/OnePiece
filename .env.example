# Create a free Supabase project at https://supabase.com and paste its
# API URL + anon key here, then copy this file to .env.local.
# Without these, live multiplayer draft sync and persisted tier lists
# fall back to local-only state (single browser, no sync between players).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only secret (Project Settings -> API -> service_role key in the
# Supabase dashboard). Never prefix this with NEXT_PUBLIC_ — it must stay
# out of the browser bundle. Used by src/app/api/auth/register to create
# accounts without triggering Supabase's email-confirmation rate limit.
SUPABASE_SERVICE_ROLE_KEY=
